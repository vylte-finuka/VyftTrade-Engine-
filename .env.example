# Copier en .env (jamais commité) puis : docker compose up -d --build
VYFTTRADE_POOL_ADDRESS=0x352aBa76dDC0c4002134333417543fbb268b21a1   # contrat Vyfthealthcore
VYFTTRADE_POOL_SEED=0               # VEZ du pool réservés au trading (0 = trading fermé)
